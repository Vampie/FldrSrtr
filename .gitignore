# Build-output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Release/publish-output van het portable releasescript, en handmatig uitgepakte
# releases die de gebruiker zelf test (bv. release_1.0.0/) — bevatten hun eigen
# runtime data (config.json, activity.jsonl, backups) en horen niet in git.
/publish/
/release/
release_*/
*.zip

# Rider / VS Code
.idea/
.vscode/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Portable-configuratie/logs die tijdens het lokaal testen ontstaan
/config/
/activity.jsonl
config.backup.*.json

# OS-ruis
Thumbs.db
desktop.ini
