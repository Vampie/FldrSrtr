<Window x:Class="FldrSrtr.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:App.Core.Model;assembly=App.Core"
        xmlns:local="clr-namespace:FldrSrtr"
        Title="Rule editor" Height="900" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:ConditionNodeLabelConverter x:Key="NodeLabelConverter" />
        <local:ActionLabelConverter x:Key="ActionLabelConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Rule name:" VerticalAlignment="Center" Width="90" />
            <TextBox x:Name="NameTextBox" Width="300" />
            <CheckBox x:Name="EnabledCheckBox" Content="Enabled" VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True" />
            <CheckBox x:Name="AdvancedModeCheckBox" Content="Advanced mode" VerticalAlignment="Center" Margin="20,0,0,0"
                      Checked="AdvancedModeCheckBox_Changed" Unchecked="AdvancedModeCheckBox_Changed" />
        </StackPanel>

        <Border Grid.Row="1" x:Name="VariableHelpPanel" Visibility="Collapsed" Background="#FFF4F4F4" Padding="8" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11">
                Variabelen (in Destination/Arguments) — klik "Insert variable" bij een actie voor het volledige, onderverdeelde menu, of typ ze zelf:
                <LineBreak />
                <Bold>Algemeen:</Bold> {Counter} (start 1, stap 1), {Counter:100}, {Counter:100:5} — telt op per verwerkt bestand in deze run, niet bewaard tussen runs.
                {Guid} — een uniek gegenereerde GUID.
                {Random} (6 cijfers) / {Random:0000} (eigen aantal cijfers/opvulling) — willekeurig getal. {RandomString} (8 tekens) / {RandomString:12} (eigen lengte) — willekeurige tekst.
                <LineBreak />
                <Bold>File:</Bold> {FileName} {OriginalName} {Extension} {OriginalExtension} {FullPath} {Directory} {FileSize}, en de datum/tijd van het bestand zelf: {CreatedYear} {CreatedMonth} {CreatedDay} {CreatedDate} {CreatedTime} (en dezelfde set met "Modified" i.p.v. "Created").
                <LineBreak />
                <Bold>Datum (huidige datum):</Bold> {Year} {Month} {Day} {Hour} {Minute} {Second} {Date} {Time}, {UnixTimestamp} / {UnixTimestampMicro} (seconden/microseconden sinds 1970).
                <LineBreak />
                Voorbeeld: D:\Archief\{Year}\{Month}\{FileName}.{Extension} — een niet-bestaande submap wordt automatisch aangemaakt.
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Conditions:" FontWeight="Bold" VerticalAlignment="Center" />
            <ToggleButton x:Name="ConditionsHelpToggle" Content="Hoe werkt dit?" Margin="12,0,0,0" Padding="6,0"
                          Checked="ConditionsHelpToggle_Changed" Unchecked="ConditionsHelpToggle_Changed" />
        </StackPanel>

        <Border Grid.Row="3" x:Name="ConditionsHelpPanel" Visibility="Collapsed" Background="#FFF4F4F4" Padding="8" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" FontSize="11">
                Een <Bold>groep</Bold> combineert condities of andere groepen: <Bold>ALL</Bold> = moeten allemaal kloppen (AND),
                <Bold>ANY</Bold> = minstens één moet kloppen (OR), <Bold>NOT</Bold> = het tegenovergestelde (moet NIET kloppen).
                Groepen kunnen genest worden voor complexere logica, bv. "extensie is pdf ÉN (naam bevat 'factuur' OF naam bevat 'invoice')".
                Klik op een groep om er een conditie of nieuwe (geneste) groep aan toe te voegen; klik op een conditie om die te bewerken.
            </TextBlock>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="ConditionsTree" Grid.Column="0" Margin="0,0,8,0"
                      SelectedItemChanged="ConditionsTree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type model:ConditionNode}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Converter={StaticResource NodeLabelConverter}}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <StackPanel Grid.Column="1" x:Name="DetailsPanel">
                <TextBlock x:Name="NoSelectionText" Text="Selecteer een groep of conditie hierboven." />

                <StackPanel x:Name="GroupDetailsPanel" Visibility="Collapsed">
                    <TextBlock Text="Groep — match:" FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox x:Name="GroupLogicComboBox" Width="120" HorizontalAlignment="Left"
                              SelectionChanged="GroupLogicComboBox_SelectionChanged" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Add condition" Tag="Icons/icon-add.png" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="AddConditionLeaf_Click" />
                        <Button Content="Add group" Tag="Icons/icon-add-folder.png" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="AddConditionGroup_Click" />
                        <Button x:Name="RemoveGroupButton" Content="Remove this group" Tag="Icons/icon-remove.png" Style="{StaticResource IconButton}" Click="RemoveSelectedNode_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="LeafDetailsPanel" Visibility="Collapsed">
                    <TextBlock Text="Conditie" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Field:" Width="70" VerticalAlignment="Center" />
                        <ComboBox x:Name="FieldComboBox" Width="120" SelectionChanged="LeafField_Changed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Operator:" Width="70" VerticalAlignment="Center" />
                        <ComboBox x:Name="OperatorComboBox" Width="150" SelectionChanged="LeafField_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="TextValuePanel" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Value:" Width="70" VerticalAlignment="Center" />
                        <TextBox x:Name="ValueTextBox" Width="220" TextChanged="LeafField_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="DateValuePanel" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock Text="Date:" Width="70" VerticalAlignment="Center" />
                        <DatePicker x:Name="DateFromPicker" Width="130" SelectedDateChanged="DatePicker_Changed" />
                        <TextBlock x:Name="DateToLabel" Text=" tot " VerticalAlignment="Center" Visibility="Collapsed" />
                        <DatePicker x:Name="DateToPicker" Width="130" SelectedDateChanged="DatePicker_Changed" Visibility="Collapsed" />
                    </StackPanel>
                    <CheckBox x:Name="CaseSensitiveCheckBox" Content="Case-sensitive" Margin="70,0,0,10" Checked="LeafField_Changed" Unchecked="LeafField_Changed" />
                    <TextBlock x:Name="DuplicateHintText" Text="Tip: bij Field 'Duplicate' is Value 'true' of 'false'." Foreground="Gray" Margin="70,0,0,10" Visibility="Collapsed" />
                    <Button Content="Remove this condition" Tag="Icons/icon-remove.png" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="RemoveSelectedNode_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Text="Actions (uitgevoerd in volgorde):" FontWeight="Bold" Grid.Row="5" Margin="0,12,0,4" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Add" Tag="Icons/icon-add.png" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="AddAction_Click" />
                    <Button Content="Up" Margin="0,0,4,0" Click="MoveActionUp_Click" />
                    <Button Content="Down" Margin="0,0,4,0" Click="MoveActionDown_Click" />
                    <Button Content="Remove" Tag="Icons/icon-remove.png" Style="{StaticResource IconButton}" Click="RemoveAction_Click" />
                </StackPanel>
                <ListBox x:Name="ActionsList" SelectionChanged="ActionsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ActionLabelConverter}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1" x:Name="ActionDetailsPanel">
                <TextBlock x:Name="NoActionSelectedText" Text="Selecteer een actie hiernaast, of voeg er een toe." />

                <StackPanel x:Name="ActionFieldsPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Action:" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="ActionTypeComboBox" Width="150" SelectionChanged="ActionType_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="ActionHelpText" Foreground="Gray" TextWrapping="Wrap" Margin="90,0,0,10" Width="600" HorizontalAlignment="Left" />

                    <StackPanel x:Name="DestinationPanel" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DestinationLabel" Text="Destination:" Width="90" VerticalAlignment="Center" />
                            <TextBox x:Name="DestinationTextBox" Width="480" TextChanged="ActionField_Changed" />
                        </StackPanel>
                        <Button x:Name="InsertDestinationVariableButton" Content="Insert variable ▾" HorizontalAlignment="Left"
                                Tag="Icons/icon-insert-variable.png" Style="{StaticResource IconButton}"
                                Margin="90,4,0,0" Click="InsertDestinationVariable_Click" />
                    </StackPanel>

                    <StackPanel x:Name="ArgumentsPanel" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Arguments:" Width="90" VerticalAlignment="Center" />
                            <TextBox x:Name="ArgumentsTextBox" Width="480" TextChanged="ActionField_Changed" />
                        </StackPanel>
                        <Button x:Name="InsertArgumentsVariableButton" Content="Insert variable ▾" HorizontalAlignment="Left"
                                Tag="Icons/icon-insert-variable.png" Style="{StaticResource IconButton}"
                                Margin="90,4,0,0" Click="InsertArgumentsVariable_Click" />
                    </StackPanel>

                    <StackPanel x:Name="OnConflictPanel" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="On conflict:" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="OnConflictComboBox" Width="150" SelectionChanged="ActionField_Changed" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="7" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Tag="Icons/icon-cancel.png" Style="{StaticResource IconButton}" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Save" Tag="Icons/icon-save.png" Style="{StaticResource IconButton}" Width="90" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
