<Window x:Class="FoldrSortr.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule editor" Height="620" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Rule name:" VerticalAlignment="Center" Width="90" />
            <TextBox x:Name="NameTextBox" Width="300" />
            <CheckBox x:Name="EnabledCheckBox" Content="Enabled" VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Match:" VerticalAlignment="Center" Width="90" />
            <ComboBox x:Name="LogicComboBox" Width="120" />
        </StackPanel>

        <TextBlock Text="Conditions:" FontWeight="Bold" Grid.Row="2" VerticalAlignment="Top" />
        <DataGrid x:Name="ConditionsGrid" Grid.Row="2" Margin="0,20,0,0" AutoGenerateColumns="False"
                  CanUserAddRows="False" ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridComboBoxColumn x:Name="FieldColumn" Header="Field" SelectedItemBinding="{Binding Field}" Width="110" />
                <DataGridComboBoxColumn x:Name="OperatorColumn" Header="Operator" SelectedItemBinding="{Binding Operator}" Width="130" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                <DataGridCheckBoxColumn Header="Case-sensitive" Binding="{Binding CaseSensitive}" Width="100" />
                <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove" Click="RemoveCondition_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="+ Add condition" Grid.Row="3" HorizontalAlignment="Left" Margin="0,4,0,12" Click="AddCondition_Click" />

        <TextBlock Text="Actions:" FontWeight="Bold" Grid.Row="4" VerticalAlignment="Top" />
        <DataGrid x:Name="ActionsGrid" Grid.Row="4" Margin="0,20,0,0" AutoGenerateColumns="False"
                  CanUserAddRows="False" ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridComboBoxColumn x:Name="ActionTypeColumn" Header="Action" SelectedItemBinding="{Binding Type}" Width="140" />
                <DataGridTextColumn Header="Destination / new name" Binding="{Binding Destination}" Width="*" />
                <DataGridComboBoxColumn x:Name="OnConflictColumn" Header="On conflict" SelectedItemBinding="{Binding OnConflict}" Width="120" />
                <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove" Click="RemoveAction_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="+ Add action" Grid.Row="5" HorizontalAlignment="Left" Margin="0,4,0,12" Click="AddAction_Click" />

        <StackPanel Orientation="Horizontal" Grid.Row="6" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Save" Width="90" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
