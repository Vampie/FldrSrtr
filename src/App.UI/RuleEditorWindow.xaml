<Window x:Class="FldrSrtr.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:App.Core.Model;assembly=App.Core"
        xmlns:local="clr-namespace:FldrSrtr"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{local:Loc RuleEditor.Title}" Height="900" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:ConditionNodeLabelConverter x:Key="NodeLabelConverter" />
        <local:ActionLabelConverter x:Key="ActionLabelConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{local:Loc RuleEditor.RuleName}" VerticalAlignment="Center" Width="90" />
            <TextBox x:Name="NameTextBox" Width="300" />
            <CheckBox x:Name="EnabledCheckBox" Content="{local:Loc Common.Enabled}" VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True" />
            <CheckBox x:Name="AdvancedModeCheckBox" Content="{local:Loc RuleEditor.AdvancedMode}" VerticalAlignment="Center" Margin="20,0,0,0"
                      Checked="AdvancedModeCheckBox_Changed" Unchecked="AdvancedModeCheckBox_Changed" />
        </StackPanel>

        <Border Grid.Row="1" x:Name="VariableHelpPanel" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11" Text="{local:Loc RuleEditor.VariableHelp.Intro}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{local:Loc RuleEditor.VariableHelp.General}" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{}{Counter} / {Counter:100} / {Counter:100:5}" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{local:Loc RuleEditor.VariableHelp.Counter}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{}{Guid}" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{local:Loc RuleEditor.VariableHelp.Guid}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{}{Random} / {Random:0000}" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{local:Loc RuleEditor.VariableHelp.Random}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{}{RandomString} / {RandomString:12}" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{local:Loc RuleEditor.VariableHelp.RandomString}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,12" />

                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{local:Loc RuleEditor.VariableHelp.File}" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{}{FileName} {Extension} {FullPath} {Directory} {FileSize} ..." FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{local:Loc RuleEditor.VariableHelp.FileProps}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,4" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{}{CreatedYear} ... {CreatedTime}" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,4">
                        <Run Text="{local:Loc RuleEditor.VariableHelp.Created}" />
                        <Run Text="{local:Loc RuleEditor.VariableHelp.Created.Warning}" Foreground="Gray" />
                    </TextBlock>
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{}{ModifiedYear} ... {ModifiedTime}" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{local:Loc RuleEditor.VariableHelp.Modified}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,12" />

                    <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="{local:Loc RuleEditor.VariableHelp.CurrentDate}" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{}{Year} {Month} {Day} {Hour} {Minute} {Second} {Date} {Time}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{local:Loc RuleEditor.VariableHelp.RunMoment}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,4" />
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="{}{UnixTimestamp} / {UnixTimestampMicro}" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Grid.Row="11" Grid.Column="1" Text="{local:Loc RuleEditor.VariableHelp.UnixTimestamp}" TextWrapping="Wrap" FontSize="11" Margin="8,0,0,0" />
                </Grid>

                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11">
                    <Run Text="{local:Loc RuleEditor.VariableHelp.Example}" />
                    <Run Text="D:\Archief\{Year}\{Month}\{FileName}.{Extension}" FontFamily="Consolas" />
                    <Run Text="{local:Loc RuleEditor.VariableHelp.Example.Suffix}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{local:Loc RuleEditor.Conditions}" FontWeight="Bold" VerticalAlignment="Center" />
            <ToggleButton x:Name="ConditionsHelpToggle" Content="{local:Loc RuleEditor.HowDoesThisWork}" Margin="12,0,0,0" Padding="6,0"
                          Checked="ConditionsHelpToggle_Changed" Unchecked="ConditionsHelpToggle_Changed" />
        </StackPanel>

        <Border Grid.Row="3" x:Name="ConditionsHelpPanel" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" FontSize="11" Text="{local:Loc RuleEditor.ConditionsHelp}" />
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="ConditionsTree" Grid.Column="0" Margin="0,0,8,0"
                      SelectedItemChanged="ConditionsTree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type model:ConditionNode}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Converter={StaticResource NodeLabelConverter}}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <StackPanel Grid.Column="1" x:Name="DetailsPanel">
                <TextBlock x:Name="NoSelectionText" Text="{local:Loc RuleEditor.SelectGroupOrCondition}" />

                <StackPanel x:Name="GroupDetailsPanel" Visibility="Collapsed">
                    <TextBlock Text="{local:Loc RuleEditor.GroupMatch}" FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox x:Name="GroupLogicComboBox" Width="120" HorizontalAlignment="Left"
                              SelectionChanged="GroupLogicComboBox_SelectionChanged" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{local:Loc RuleEditor.AddCondition}" Tag="Icons/icon-add.png" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="AddConditionLeaf_Click" />
                        <Button Content="{local:Loc RuleEditor.AddGroup}" Tag="Icons/icon-add-folder.png" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="AddConditionGroup_Click" />
                        <Button x:Name="RemoveGroupButton" Content="{local:Loc RuleEditor.RemoveThisGroup}" Tag="Icons/icon-remove.png" Style="{StaticResource IconButton}" Click="RemoveSelectedNode_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="LeafDetailsPanel" Visibility="Collapsed">
                    <TextBlock Text="{local:Loc RuleEditor.Condition}" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{local:Loc RuleEditor.Field}" Width="70" VerticalAlignment="Center" />
                        <ComboBox x:Name="FieldComboBox" Width="120" SelectionChanged="LeafField_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="AllFieldHintText" Text="{local:Loc RuleEditor.AllFieldHint}" Foreground="Gray" Margin="0,0,0,6" Visibility="Collapsed" />
                    <StackPanel x:Name="OperatorRow" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{local:Loc RuleEditor.Operator}" Width="70" VerticalAlignment="Center" />
                        <ComboBox x:Name="OperatorComboBox" Width="150" SelectionChanged="LeafField_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="TextValuePanel" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{local:Loc RuleEditor.Value}" Width="70" VerticalAlignment="Center" />
                        <TextBox x:Name="ValueTextBox" Width="220" TextChanged="LeafField_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="DateValuePanel" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock Text="{local:Loc RuleEditor.Date}" Width="70" VerticalAlignment="Center" />
                        <DatePicker x:Name="DateFromPicker" Width="130" SelectedDateChanged="DatePicker_Changed" />
                        <TextBlock x:Name="DateToLabel" Text="{local:Loc RuleEditor.DateTo}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <DatePicker x:Name="DateToPicker" Width="130" SelectedDateChanged="DatePicker_Changed" Visibility="Collapsed" />
                    </StackPanel>
                    <CheckBox x:Name="CaseSensitiveCheckBox" Content="{local:Loc RuleEditor.CaseSensitive}" Margin="70,0,0,10" Checked="LeafField_Changed" Unchecked="LeafField_Changed" />
                    <TextBlock x:Name="DuplicateHintText" Text="{local:Loc RuleEditor.DuplicateHint}" Foreground="Gray" Margin="70,0,0,10" Visibility="Collapsed" />
                    <Button Content="{local:Loc RuleEditor.RemoveThisCondition}" Tag="Icons/icon-remove.png" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="RemoveSelectedNode_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Text="{local:Loc RuleEditor.ActionsInOrder}" FontWeight="Bold" Grid.Row="5" Margin="0,12,0,4" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="{local:Loc Common.Add}" Tag="Icons/icon-add.png" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="AddAction_Click" />
                    <Button Content="{local:Loc Common.Up}" Margin="0,0,4,0" Click="MoveActionUp_Click" />
                    <Button Content="{local:Loc Common.Down}" Margin="0,0,4,0" Click="MoveActionDown_Click" />
                    <Button Content="{local:Loc Common.Remove}" Tag="Icons/icon-remove.png" Style="{StaticResource IconButton}" Click="RemoveAction_Click" />
                </StackPanel>
                <ListBox x:Name="ActionsList" SelectionChanged="ActionsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ActionLabelConverter}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1" x:Name="ActionDetailsPanel">
                <TextBlock x:Name="NoActionSelectedText" Text="{local:Loc RuleEditor.SelectOrAddAction}" />

                <StackPanel x:Name="ActionFieldsPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{local:Loc RuleEditor.Action}" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="ActionTypeComboBox" Width="150" SelectionChanged="ActionType_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="ActionHelpText" Foreground="Gray" TextWrapping="Wrap" Margin="90,0,0,10" Width="600" HorizontalAlignment="Left" />

                    <StackPanel x:Name="DestinationPanel" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DestinationLabel" Text="{local:Loc RuleEditor.Destination}" Width="90" VerticalAlignment="Center" />
                            <TextBox x:Name="DestinationTextBox" Width="480" TextChanged="ActionField_Changed" />
                        </StackPanel>
                        <Button x:Name="InsertDestinationVariableButton" Content="{local:Loc Common.InsertVariable}" HorizontalAlignment="Left"
                                Tag="Icons/icon-insert-variable.png" Style="{StaticResource IconButton}"
                                Margin="90,4,0,0" Click="InsertDestinationVariable_Click" />
                    </StackPanel>

                    <StackPanel x:Name="ArgumentsPanel" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{local:Loc RuleEditor.Arguments}" Width="90" VerticalAlignment="Center" />
                            <TextBox x:Name="ArgumentsTextBox" Width="480" TextChanged="ActionField_Changed" />
                        </StackPanel>
                        <Button x:Name="InsertArgumentsVariableButton" Content="{local:Loc Common.InsertVariable}" HorizontalAlignment="Left"
                                Tag="Icons/icon-insert-variable.png" Style="{StaticResource IconButton}"
                                Margin="90,4,0,0" Click="InsertArgumentsVariable_Click" />
                    </StackPanel>

                    <StackPanel x:Name="OnConflictPanel" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{local:Loc RuleEditor.OnConflict}" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="OnConflictComboBox" Width="150" SelectionChanged="ActionField_Changed" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="7" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{local:Loc Common.Cancel}" Tag="Icons/icon-cancel.png" Style="{StaticResource IconButton}" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="{local:Loc Common.Save}" Tag="Icons/icon-save.png" Style="{StaticResource IconButton}" Width="90" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
