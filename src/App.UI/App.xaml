<Application x:Class="FldrSrtr.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FldrSrtr"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--
            Icon buttons: set Tag to an icon's pack-relative path (e.g. "Icons/icon-add.png") and
            Content to the label text. Buttons with no Tag render exactly as a plain Button —
            the reordering "Up"/"Down" buttons and the "Hoe werkt dit?" toggle intentionally have
            no matching icon and are left as text-only.
        -->
        <DataTemplate x:Key="IconButtonContentTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding RelativeSource={RelativeSource AncestorType=ButtonBase}, Path=Tag, Converter={x:Static local:IconPathConverter.Instance}}"
                       Width="16" Height="16" Margin="0,0,5,0"
                       Visibility="{Binding RelativeSource={RelativeSource AncestorType=ButtonBase}, Path=Tag, Converter={x:Static local:NullToVisibilityConverter.Instance}}" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="ContentTemplate" Value="{StaticResource IconButtonContentTemplate}" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </Application.Resources>
</Application>
