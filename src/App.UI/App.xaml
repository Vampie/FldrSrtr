<Application x:Class="FldrSrtr.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FldrSrtr"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent-style theme + restyled built-in controls (Button, TextBox, ComboBox,
                     DataGrid, TabControl, ...) for every window, without touching each control's
                     own markup — Stap 21 "modernize the layout" (see CLAUDE.md's original
                     architecture decision, which named ModernWpf/WPF-UI as the intended path for
                     this, never implemented until now). -->
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Icon buttons: set Tag to an icon's pack-relative path (e.g. "Icons/icon-add.png") and
                Content to the label text. Buttons with no Tag render exactly as a plain Button —
                the reordering "Up"/"Down" buttons and the "Hoe werkt dit?" toggle intentionally have
                no matching icon and are left as text-only. BasedOn the implicit Button style above
                so icon buttons keep ModernWpf's chrome (hover/press states, rounded corners) instead
                of reverting to the classic Win32 look.
            -->
            <DataTemplate x:Key="IconButtonContentTemplate">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding RelativeSource={RelativeSource AncestorType=ButtonBase}, Path=Tag, Converter={x:Static local:IconPathConverter.Instance}}"
                           Width="16" Height="16" Margin="0,0,6,0"
                           Visibility="{Binding RelativeSource={RelativeSource AncestorType=ButtonBase}, Path=Tag, Converter={x:Static local:NullToVisibilityConverter.Instance}}" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="ContentTemplate" Value="{StaticResource IconButtonContentTemplate}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0,0,0,0" />
            </Style>

            <!-- ModernWpf's default ListBoxItem padding/min-height is touch-sized and makes dense
                 lists (folders, rules, protected-folder/extension entries) take up far more room
                 than the content needs — this tightens rows back down for that kind of list. -->
            <Style x:Key="CompactListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!-- Soft "card" surface for grouping content (Dashboard stat tiles, the quick-action
                 panel, help panels, ...) — replaces the flat 1px gray-Border look with a subtly
                 shaded, rounded surface that follows the active (light/dark) theme automatically. -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
