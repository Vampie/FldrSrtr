<Window x:Class="FoldrSortr.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflict" Height="180" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Skip" Width="90" Margin="0,0,8,0" Click="Skip_Click" />
            <Button Content="Overwrite" Width="90" Margin="0,0,8,0" Click="Overwrite_Click" />
            <Button Content="Rename" Width="90" Click="Rename_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
