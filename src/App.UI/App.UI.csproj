<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>FldrSrtr</RootNamespace>
    <AssemblyName>FldrSrtr</AssemblyName>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <!-- Keep InformationalVersion exactly what release.ps1 passes via -p:Version (e.g. "1.2.11") —
         the SDK otherwise appends "+<git-commit-hash>", which is noise in the titlebar. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ookii.Dialogs.WinForms" Version="4.0.0" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Button icon packs — deliberately NOT embedded: copied next to the exe as plain files
         (portable rule still holds, this is just a folder living alongside it instead of inside
         it) so a pack can be added or edited without rebuilding. Source originals live in
         Resources/icons outside the repo. Active pack switched at startup (and live from
         Settings) via AppSettings.IconSet — see IconSetProvider/IconPathConverter. Each pack
         folder also has an icons.json manifest (key -> actual filename) — see IconSetProvider. -->
    <None Include="IconSets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="IconSets\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI text — also plain files next to the exe, same reasoning as IconSets: adding a
         language is dropping in a new Languages\<code>.json, no rebuild needed. See
         Localization/LocExtension. -->
    <None Include="Languages\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Core\App.Core.csproj" />
    <ProjectReference Include="..\App.Infrastructure\App.Infrastructure.csproj" />
  </ItemGroup>

</Project>
