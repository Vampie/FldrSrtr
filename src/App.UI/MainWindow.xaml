<Window x:Class="FoldrSortr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoldrSortr" Height="700" Width="1100"
        Loaded="Window_Loaded">
    <TabControl Margin="8">
        <TabItem Header="Dashboard">
            <TextBlock Text="Dashboard — statistieken volgen in Fase 4" Margin="16" />
        </TabItem>

        <TabItem Header="Folders">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Folders -->
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,8,0,0">
                        <Button Content="+ Add folder" Margin="0,0,0,4" Click="AddFolder_Click" />
                        <Button Content="Remove folder" Margin="0,0,0,4" Click="RemoveFolder_Click" />
                        <Button Content="Open in Explorer" Margin="0,0,0,4" Click="OpenInExplorer_Click" />
                        <Button Content="Scan now" Click="ScanNow_Click" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Folders" FontWeight="Bold" Margin="0,0,0,4" />
                    <ListBox x:Name="FoldersList" SelectionChanged="FoldersList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Rules + results for the selected folder -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="140" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="RulesHeaderText" Grid.Row="0" FontWeight="Bold" Text="Selecteer een folder" Margin="0,0,0,4" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="+ Add rule" Margin="0,0,4,0" Click="AddRule_Click" />
                        <Button Content="Edit rule" Margin="0,0,4,0" Click="EditRule_Click" />
                        <Button Content="Delete rule" Margin="0,0,16,0" Click="DeleteRule_Click" />
                        <Button Content="Test Rule (dry run)" Margin="0,0,4,0" Click="DryRun_Click" />
                        <Button Content="Run rule" Click="RunRule_Click" />
                    </StackPanel>

                    <ListBox x:Name="RulesList" Grid.Row="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Text="Resultaat:" FontWeight="Bold" Margin="0,8,0,4" />

                    <DataGrid x:Name="ResultsGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bestand" Binding="{Binding FileName}" Width="180" />
                            <DataGridTextColumn Header="Actie" Binding="{Binding Action}" Width="100" />
                            <DataGridTextColumn Header="Van" Binding="{Binding FromPath}" Width="*" />
                            <DataGridTextColumn Header="Naar" Binding="{Binding ToPath}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            <DataGridTextColumn Header="Melding" Binding="{Binding Message}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="SummaryText" Grid.Row="5" Margin="0,4,0,0" />
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Rules">
            <TextBlock Text="Regels worden per folder beheerd op het Folders-tabblad." Margin="16" />
        </TabItem>

        <TabItem Header="Activity">
            <DockPanel Margin="8">
                <Button DockPanel.Dock="Top" Content="Refresh" HorizontalAlignment="Left" Margin="0,0,0,8" Click="RefreshActivity_Click" />
                <DataGrid x:Name="ActivityGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tijd (UTC)" Binding="{Binding TimestampUtc}" Width="150" />
                        <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="180" />
                        <DataGridTextColumn Header="Regel" Binding="{Binding RuleName}" Width="120" />
                        <DataGridTextColumn Header="Bestand" Binding="{Binding FileName}" Width="140" />
                        <DataGridTextColumn Header="Actie" Binding="{Binding Action}" Width="90" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                        <DataGridTextColumn Header="Melding" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Settings">
            <TextBlock Text="Settings — instellingen volgen in latere fases" Margin="16" />
        </TabItem>
    </TabControl>
</Window>
